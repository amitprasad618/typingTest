{
  "routes": [
    {
      "src": "/sitemap-new.xml",
      "dest": "/sitemap-new.xml",
      "headers": {
        "Cache-Control": "s-maxage=0, max-age=0, must-revalidate",
        "Content-Type": "application/xml"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}